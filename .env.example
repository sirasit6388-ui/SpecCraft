PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pc_builder
USD_TO_THB_RATE=36.5
MYSQL_BIN=C:\Program Files\MySQL\MySQL Server 9.7\bin\mysql.exe

# Optional: enables the "Login with Google" button. Leave blank to keep it disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional: enables the "Login with Facebook" button. Leave blank to keep it disabled.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback
